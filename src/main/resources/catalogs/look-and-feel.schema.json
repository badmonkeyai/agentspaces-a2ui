{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://badmonkey.ai/agentspaces/a2ui/v1/look-and-feel.schema.json",
  "title": "Look and feel",
  "description": "The tokens a published application draws with: colours, type, spacing, density, radius, shadow; light and dark modes, each selected for its surface; a texture for the colour-blind and print case. Tokens only: no URL, no markup, no stylesheet.",
  "type": "object",
  "required": ["schemaVersion", "id", "tokens"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "tokens": { "$ref": "#/$defs/mode" },
    "dark": { "$ref": "#/$defs/mode" },
    "texture": { "type": "object", "properties": { "fill": { "enum": ["diagonal", "dots", "none"] } } },
    "validated": { "type": "object", "properties": { "at": { "type": "string" }, "by": { "type": "string" }, "ok": { "type": "boolean" } } },
    "version": { "type": "integer", "minimum": 0 },
    "state": { "type": "string" }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "mode": {
      "type": "object",
      "required": ["color"],
      "properties": {
        "color": { "type": "object", "required": ["surface", "ink", "accent", "categorical", "status"],
          "properties": {
            "surface": { "$ref": "#/$defs/hex" }, "ink": { "$ref": "#/$defs/hex" }, "inkMuted": { "$ref": "#/$defs/hex" }, "accent": { "$ref": "#/$defs/hex" },
            "categorical": { "type": "array", "items": { "$ref": "#/$defs/hex" }, "minItems": 8, "maxItems": 8 },
            "sequential": { "$ref": "#/$defs/hex" },
            "diverging": { "type": "object", "properties": { "warm": { "$ref": "#/$defs/hex" }, "neutral": { "$ref": "#/$defs/hex" }, "cool": { "$ref": "#/$defs/hex" } } },
            "status": { "type": "object", "required": ["good", "warning", "serious", "critical"], "additionalProperties": { "$ref": "#/$defs/hex" } } } },
        "type": { "type": "object", "properties": { "family": { "type": "string", "pattern": "^[A-Za-z0-9 ,'-]+$" }, "scale": { "type": "array", "items": { "type": "number" } } } },
        "space": { "type": "object", "properties": { "unit": { "type": "number" }, "density": { "enum": ["comfortable", "compact"] } } },
        "radius": { "type": "number" },
        "shadow": { "enum": ["none", "soft", "strong"] }
      }
    }
  }
}
