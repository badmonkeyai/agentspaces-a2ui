        "title",
        "child"
      ],
      "additionalProperties": false
    },
    "Conversation": {
      "description": "A chat with an agent: the lines of one key from the data model, newest last; a line typed is written as a ChatMessage through the page's write action. An alias of the widgets catalog's Chat through 0.6.x, drawn by it.",
      "type": "object",
      "properties": {
        "component": {
          "const": "Conversation"
        },
        "lines": {
          "type": "string",
          "description": "a path to the ChatMessage rows"
        },
        "key": {
          "type": "string",
          "description": "the thread; lines of other keys are not shown"
        },
        "agent": {
          "type": "string",
          "description": "the agent that answers, shown as the counterpart"
        },
        "placeholder": {
          "type": "string",
          "default": "Ask the agent"
        },
        "writeAction": {
          "type": "string",
          "description": "the action a sent line dispatches with {type: ChatMessage, entry}",
