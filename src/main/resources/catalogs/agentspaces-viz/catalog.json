{
  "$schema": "https://a2ui.org/specification/v1_0/catalog_definition.json",
  "protocolVersion": "1.0",
  "catalogId": "agentspaces-viz",
  "title": "AgentSpaces visualisation catalog",
  "description": "The components people look at in a published application: charts by the dataviz method, tables, maps, graphs, timelines, reports, notifications, forms, and stat tiles, and the frame around them (a title bar, menus, panel splits). An agent names series and paths; the renderer draws with the host's look and feel; nothing executes.",
  "instructions": "charts: the dataviz method: categorical hues in fixed order and never cycled; one hue for magnitude; two hues and a neutral midpoint for polarity; the status palette reserved; a legend for two series or more and direct labels for four or fewer; a hover layer; a table view beside every chart. noCode: a component carries data paths, names, and tokens; no script, no URL loads, no markup.",
  "metadata": {
    "extensions": {
      "agentspaces": {
        "version": "1",
        "rules": {
          "charts": "the dataviz method: categorical hues in fixed order and never cycled; one hue for magnitude; two hues and a neutral midpoint for polarity; the status palette reserved; a legend for two series or more and direct labels for four or fewer; a hover layer; a table view beside every chart",
          "noCode": "a component carries data paths, names, and tokens; no script, no URL loads, no markup"
        }
      }
    }
  },
  "components": {
    "Chart": {
      "description": "One chart of one kind over series bound to the data model; hues in fixed order from the look and feel; a legend for two series or more; a table view beside it.",
      "type": "object",
      "properties": {
        "component": {
          "const": "Chart"
        },
        "kind": {
          "enum": [
            "bar",
            "line",
            "area",
            "stat",
            "sparkline",
            "heatmap"
          ]
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "color": {
                "type": "string",
                "description": "a token name, never a colour"
              }
            },
            "required": [
              "name",
              "path"
            ]
          },
          "maxItems": 8
        },
        "x": {
          "type": "string"
        },
        "y": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "legend": {
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto"
        },
        "table": {
          "type": "boolean",
          "default": true
        },
        "id": {
          "$ref": "#/$defs/ComponentId",
          "description": "the component's id, unique on its surface"
        },
        "catalogId": {
          "$ref": "#/$defs/CatalogId"
        },
        "accessibility": {
          "$ref": "#/$defs/AccessibilityAttributes"
        },
        "metadata": {
          "$ref": "#/$defs/ComponentMetadata"
        }
      },
      "required": [
        "component",
        "kind",
        "series"
      ],
      "additionalProperties": false
    },
    "Visualize": {
      "description": "A chart of a bound table by a small spec: a mark (bar, column, line, area, scatter, or table), the x column, one y column or several, a column whose values split the series, an aggregate per x, and a sort. It follows the dataviz method: one value axis, a legend for two series or more, direct labels for four or fewer, hues from the look in fixed order, a ninth series folded into Other, a hover tooltip on every mark and a crosshair on a line or an area, and a table view. A spec that names a column the table lacks says so.",
      "type": "object",
      "properties": {
        "component": {
          "const": "Visualize"
        },
        "rows": {
          "type": "string",
          "description": "the table in the data model: a list of rows"
        },
        "mark": {
          "enum": [
            "bar",
            "column",
            "line",
            "area",
            "scatter",
            "table"
          ],
          "default": "column"
        },
        "x": {
          "type": "string",
          "description": "the column along the categories (or the x axis of a scatter)"
        },
        "y": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "the column of values, or a list of columns, one series each"
        },
        "color": {
          "type": "string",
          "description": "a column whose values split the rows into series"
        },
        "aggregate": {
          "enum": [
            "sum",
            "mean",
            "count",
            "none"
          ],
          "default": "none"
        },
        "sort": {
          "type": "string",
          "description": "x, y or a column; a leading - sorts descending"
        },
        "title": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "table": {
          "enum": [
            "toggle",
            "below"
          ],
          "default": "toggle"
        },
        "id": {
          "$ref": "#/$defs/ComponentId",
          "description": "the component's id, unique on its surface"
        },
        "catalogId": {
          "$ref": "#/$defs/CatalogId"
        },
        "accessibility": {
          "$ref": "#/$defs/AccessibilityAttributes"
        },
        "metadata": {
          "$ref": "#/$defs/ComponentMetadata"
        }
      },
      "required": [
        "component",
        "rows",
        "x"
      ],
      "additionalProperties": false
    },
    "DataTable": {
      "description": "A virtualised table over rows bound to the data model, with sort, filter, paging, and a row action.",
      "type": "object",
      "properties": {
        "component": {
          "const": "DataTable"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "format": {
                "type": "string"
              },
              "width": {
                "type": "integer"
              }
            },
            "required": [
              "key"
            ]
          }
        },
        "rows": {
          "type": "string"
        },
        "sort": {
          "type": "string"
        },
        "filter": {
          "type": "boolean",
          "default": true
        },
        "pageSize": {
          "type": "integer",
          "default": 50
        },
        "rowAction": {
          "type": "string",
          "description": "the action a row's button dispatches with {row}"
        },
        "rowActionLabel": {
          "type": "string",
          "description": "the words on each row's button; the action's name when absent. The button's accessible name adds the row's first column, so a screen reader tells the rows' buttons apart"
        },
        "id": {
          "$ref": "#/$defs/ComponentId",
          "description": "the component's id, unique on its surface"
        },
        "catalogId": {
          "$ref": "#/$defs/CatalogId"
        },
        "accessibility": {
          "$ref": "#/$defs/AccessibilityAttributes"
        },
        "metadata": {
          "$ref": "#/$defs/ComponentMetadata"
        }
      },
      "required": [
        "component",
        "columns",
        "rows"
      ],
      "additionalProperties": false
    },
    "Map": {
      "description": "A map of layers over the surface's data: icons that move as a key's position changes, tracks, areas (geofences), heat, GeoJSON, markers; alert boxes near their keys; a legend and a table view; a marker action and an alert action.",
      "type": "object",
      "properties": {
        "component": {
          "const": "Map"
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "icons",
                  "markers",
                  "tracks",
                  "areas",
                  "heat",
                  "geojson",
                  "alerts"
                ]
              },
              "path": {
                "type": "string",
                "description": "the rows of the layer in the data model (lat and lon per row; areas carry a polygon or a geometry; alerts carry a key, a severity, a title)"
              },
              "key": {
                "type": "string",
                "description": "the field that names a key (a unit); an icons layer keeps one icon per key, a tracks layer one path per key"
              },
              "label": {
                "type": "string",
                "description": "the field drawn beside an icon"
              },
              "icon": {
                "enum": [
                  "dot",
                  "pin",
                  "truck",
                  "van",
                  "car",
                  "plane",
                  "ship",
                  "person",
                  "arrow"
                ],
                "default": "dot"
              },
              "size": {
                "type": "number",
                "description": "the icon's size in pixels",
                "default": 28
              },
              "heading": {
                "type": "string",
                "description": "the field with a bearing in degrees; without it the bearing is from the previous position"
              },
              "timeField": {
                "type": "string",
                "default": "at"
              },
              "trail": {
                "type": "integer",
                "description": "a tracks layer draws the last trail positions per key",
                "default": 50
              },
              "color": {
                "type": "string",
                "description": "a hue of the look's categorical set by index (0 to 7), or empty for the layer's turn"
              }
            },
            "required": [
              "kind",
              "path"
            ]
          }
        },
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "zoom": {
          "type": "number"
        },
        "fit": {
          "enum": [
            "auto",
            "none"
          ],
          "default": "auto"
        },
        "transition": {
          "type": "integer",
          "description": "milliseconds an icon takes from its previous to its newest position",
          "default": 1000
        },
        "follow": {
          "type": "string",
          "description": "a path to the key the map keeps centred, or empty"
        },
        "highlight": {
          "type": "string",
          "description": "a path to the keys drawn highlighted (a ring and a larger icon)"
        },
        "legend": {
          "type": "boolean",
          "default": true
        },
        "table": {
          "type": "boolean",
          "description": "a table view of the rows of each layer, the dataviz rule",
          "default": true
        },
        "markerAction": {
          "type": "string",
          "description": "dispatched with the row when an icon or a marker is clicked"
        },
        "alertAction": {
          "type": "string",
          "description": "dispatched with the alert's id and key from an alert box's Acknowledge"
        },
        "id": {
          "$ref": "#/$defs/ComponentId",
          "description": "the component's id, unique on its surface"
        },
        "catalogId": {
          "$ref": "#/$defs/CatalogId"
        },
        "accessibility": {
          "$ref": "#/$defs/AccessibilityAttributes"
        },
        "metadata": {
          "$ref": "#/$defs/ComponentMetadata"
        }
      },
      "required": [
        "component",
        "layers"
      ],
      "additionalProperties": false
    },
    "Graph": {
      "description": "Nodes and edges bound to the data model, laid out in columns, by force, or as a tree; a node action. Rows marked lit: true light a path: a lit node draws lit, and when any edge row is lit an edge lights only when it is lit, hovered, or touches the hovered or focused node; a lit node's and a lit edge's accessible text add \", on the path\".",
      "type": "object",
      "properties": {
        "component": {
          "const": "Graph"
        },
        "nodes": {
          "type": "string",
          "description": "the path of the node rows: id, title, sub, column or kind, and lit: true for a node on the path"
        },
        "edges": {
          "type": "string",
          "description": "the path of the edge rows: from, to, label, and lit: true for an edge on the path; when any edge row is lit, the other edges light only on hover or focus of a node they touch"
        },
        "layout": {
          "enum": [
            "columns",
            "force",
            "tree"
          ],
          "default": "columns"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "nodeAction": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ComponentId",
          "description": "the component's id, unique on its surface"
        },
        "catalogId": {
          "$ref": "#/$defs/CatalogId"
        },
        "accessibility": {
          "$ref": "#/$defs/AccessibilityAttributes"
        },
        "metadata": {
          "$ref": "#/$defs/ComponentMetadata"
        }
      },
      "required": [
        "component",
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "GraphView": {
      "description": "A graph of nodes and edges: a nodes table (id, label, kind) and an edges table (source, target, rel), or GeoFeatures with their links, laid out by force, as a tree, or in layers. A person pans, zooms, drags a node, and clicks one to select it; a node whose id is a GeoFeature's selects that feature on the map. Nodes are coloured by kind from the look in fixed order, with a legend. Rows marked lit: true light a path: lit nodes draw in the selected style and lit edges with the accent stroke, beside a person's own selection, and a lit node's and a lit edge's accessible text add \", on the path\".",
      "type": "object",
      "properties": {
        "component": {
          "const": "GraphView"
        },
        "nodes": {
          "type": "string",
          "description": "the nodes table in the data model: rows with id, label and kind, and lit: true for a node on the path"
        },
        "edges": {
          "type": "string",
          "description": "the edges table: rows with source, target and rel, and lit: true for an edge on the path"
        },
        "features": {
          "type": "string",
          "description": "GeoFeatures whose links are the edges, instead of the two tables"
        },
        "layout": {
          "enum": [
            "force",
            "tree",
            "layered"
          ],
          "default": "force"
        },
        "map": {
          "$ref": "#/$defs/ComponentId",
          "description": "the id of a GeoMap on this surface a node selects on; in a GeoLayout, the layout's map"
        },
        "selectAction": {
          "type": "string",
          "description": "dispatched with the node's id and kind when a person selects it"
        },
        "title": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ComponentId",
          "description": "the component's id, unique on its surface"
        },
        "catalogId": {
          "$ref": "#/$defs/CatalogId"
        },
        "accessibility": {
          "$ref": "#/$defs/AccessibilityAttributes"
        },
        "metadata": {
          "$ref": "#/$defs/ComponentMetadata"
        }
      },
      "required": [
        "component"
      ],
      "additionalProperties": false
    },
    "Timeline": {
      "description": "Events on lanes over time.",
      "type": "object",
      "properties": {
        "component": {
          "const": "Timeline"
        },
        "events": {
          "type": "string"
        },
        "lanes": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ComponentId",
          "description": "the component's id, unique on its surface"
        },
        "catalogId": {
          "$ref": "#/$defs/CatalogId"
        },
        "accessibility": {
          "$ref": "#/$defs/AccessibilityAttributes"
        },
        "metadata": {
          "$ref": "#/$defs/ComponentMetadata"
        }
      },
      "required": [
        "component",
        "events"
      ],
      "additionalProperties": false
    },
    "Report": {
      "description": "A document of sections (text as Markdown, charts, tables, graphs, maps) exported as Markdown or printed to PDF.",
      "type": "object",
      "properties": {
        "component": {
          "const": "Report"
        },
        "title": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "heading": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "text",
                  "chart",
                  "table",
                  "graph",
                  "map"
                ]
              },
              "text": {
                "type": "string"
              },
              "component": {
                "type": "object"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "export": {
          "type": "array",
          "items": {
            "enum": [
              "markdown",
              "pdf"
            ]
          },
          "default": [
            "markdown",
            "pdf"
          ]
        },
        "id": {
          "$ref": "#/$defs/ComponentId",
          "description": "the component's id, unique on its surface"
        },
        "catalogId": {
          "$ref": "#/$defs/CatalogId"
        },
        "accessibility": {
          "$ref": "#/$defs/AccessibilityAttributes"
        },
        "metadata": {
          "$ref": "#/$defs/ComponentMetadata"
        }
      },
      "required": [
        "component",
        "title",
        "sections"
      ],
      "additionalProperties": false
    },
    "Notification": {
      "description": "Alerts or incidents bound to the data model, grouped, with acknowledge and route actions.",
      "type": "object",
