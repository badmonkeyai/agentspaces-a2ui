        },
        "id": {
          "$ref": "#/$defs/ComponentId",
          "description": "the component's id, unique on its surface"
        },
        "catalogId": {
          "$ref": "#/$defs/CatalogId"
        },
        "accessibility": {
          "$ref": "#/$defs/AccessibilityAttributes"
        },
        "metadata": {
          "$ref": "#/$defs/ComponentMetadata"
        }
      },
      "required": [
        "component",
        "lines",
        "key"
      ],
      "additionalProperties": false
    },
    "Notice": {
      "description": "A status box: a severity word with its icon and colour (never colour alone), a title, a text; from literals or paths.",
      "type": "object",
      "properties": {
        "component": {
          "const": "Notice"
        },
        "status": {
          "enum": [
            "info",
            "good",
            "warning",
            "serious",
            "critical"
          ],
          "default": "info"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "description": "the text, or a path to it"
        },
        "dismissAction": {
          "type": "string"
        },
        "statusPath": {
          "type": "string",
          "description": "a path to the status word, which wins over status when it holds one of the five words"
        },
        "id": {
          "$ref": "#/$defs/ComponentId",
          "description": "the component's id, unique on its surface"
        },
        "catalogId": {
          "$ref": "#/$defs/CatalogId"
        },
        "accessibility": {
          "$ref": "#/$defs/AccessibilityAttributes"
        },
        "metadata": {
          "$ref": "#/$defs/ComponentMetadata"
        }
      },
      "required": [
        "component",
        "title"
      ],
      "additionalProperties": false
    },
    "Toolbar": {
      "description": "A row of actions: each a label and the action it dispatches, with an optional context.",
      "type": "object",
      "properties": {
        "component": {
          "const": "Toolbar"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "primary": {
                "type": "boolean"
              },
              "context": {
                "type": "object"
              }
            },
            "required": [
              "label",
              "action"
            ]
          }
        },
        "title": {
          "type": "string"
        },
        "menu": {
          "$ref": "#/$defs/ComponentId",
          "description": "the id of a Menu drawn as the toolbar's overflow"
        },
        "id": {
          "$ref": "#/$defs/ComponentId",
          "description": "the component's id, unique on its surface"
        },
        "catalogId": {
          "$ref": "#/$defs/CatalogId"
        },
        "accessibility": {
          "$ref": "#/$defs/AccessibilityAttributes"
        },
        "metadata": {
          "$ref": "#/$defs/ComponentMetadata"
        }
      },
      "required": [
        "component",
        "actions"
      ],
      "additionalProperties": false
    },
    "KeyValue": {
      "description": "Facts as label and value pairs: the items given (a value or a path each), or every field of the object at a path.",
      "type": "object",
      "properties": {
        "component": {
          "const": "KeyValue"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string",
                "description": "a value, or a path to it"
              }
            },
            "required": [
              "label"
            ]
          }
        },
        "path": {
          "type": "string",
          "description": "an object whose fields are the pairs"
        },
        "title": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ComponentId",
          "description": "the component's id, unique on its surface"
        },
        "catalogId": {
          "$ref": "#/$defs/CatalogId"
        },
        "accessibility": {
          "$ref": "#/$defs/AccessibilityAttributes"
        },
        "metadata": {
          "$ref": "#/$defs/ComponentMetadata"
        }
      },
      "required": [
        "component"
      ],
      "additionalProperties": false
    },
    "Prose": {
      "description": "Markdown text as safe HTML (no raw HTML, http links only): the text, or a path to it.",
      "type": "object",
      "properties": {
        "component": {
          "const": "Prose"
        },
        "text": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ComponentId",
          "description": "the component's id, unique on its surface"
        },
        "catalogId": {
          "$ref": "#/$defs/CatalogId"
        },
        "accessibility": {
          "$ref": "#/$defs/AccessibilityAttributes"
        },
        "metadata": {
          "$ref": "#/$defs/ComponentMetadata"
        }
      },
      "required": [
        "component",
        "text"
      ],
      "additionalProperties": false
    },
    "TitleBar": {
      "description": "The page's one bar: the app's name and icon, a subtitle, a status read from the WorkingOn rows at a path (any row working shows the working label, failed the failed label, input-required the input label, else the idle label), the actions a design declares, and a Menu by id; the page chrome folds its own title into it.",
      "type": "object",
      "properties": {
        "component": {
          "const": "TitleBar"
        },
        "title": {
          "$ref": "#/$defs/TextOrBinding",
          "description": "a literal, or {\"@path\": ...} into the data model"
        },
        "subtitle": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "description": "an icon name from the renderer's set, such as briefcase"
        },
        "status": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "description": "a path to WorkingOn rows"
            },
            "labels": {
              "type": "object",
              "properties": {
                "working": {
                  "type": "string",
                  "default": "Working"
                },
                "idle": {
                  "type": "string",
                  "default": "Ready"
                },
                "input": {
                  "type": "string",
                  "default": "Needs your input"
                },
                "failed": {
                  "type": "string",
                  "default": "The agent stopped"
                }
              }
            }
          },
          "required": [
            "from"
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HeaderAction",
            "description": "a button in a header: an id, its words, an icon name, and the action it dispatches"
          },
          "maxItems": 6
        },
        "menu": {
          "$ref": "#/$defs/ComponentId",
          "description": "the id of a Menu drawn as the bar's overflow"
        },
        "id": {
          "$ref": "#/$defs/ComponentId",
          "description": "the component's id, unique on its surface"
        },
        "catalogId": {
          "$ref": "#/$defs/CatalogId"
        },
        "accessibility": {
          "$ref": "#/$defs/AccessibilityAttributes"
        },
        "metadata": {
          "$ref": "#/$defs/ComponentMetadata"
        }
      },
      "required": [
        "component",
        "title"
      ],
      "additionalProperties": false
    },
    "Menu": {
      "description": "A menu (the WAI-ARIA Menu Button and Menu patterns) behind a menu button, an overflow, or a context menu on a row or a file: items with groups, disabled and checked items, shortcuts, and one level of submenu; an item dispatches its action.",
      "type": "object",
      "properties": {
        "component": {
          "const": "Menu"
        },
        "trigger": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "button",
                "overflow",
                "context"
              ],
              "default": "button"
            },
            "label": {
              "type": "string",
              "description": "the trigger's words, or its accessible name for an overflow"
            }
          }
        },
        "items": {
          "description": "the items, or a path to them in the data model",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "shortcut": {
                    "type": "string",
                    "description": "the keys shown beside the item, such as Ctrl+Shift+O; the menu answers them while it is open"
                  },
                  "group": {
                    "type": "string",
                    "description": "items of one group sit together, a separator between groups"
                  },
                  "disabled": {
                    "type": "boolean",
                    "default": false
                  },
                  "checked": {
                    "$ref": "#/$defs/TextOrBinding",
                    "description": "true or false, or {\"@path\": ...} into the data model"
                  },
                  "action": {
                    "$ref": "#/$defs/NamedAction"
                  },
                  "items": {
                    "type": "array",
                    "description": "a submenu, one level deep: items with no items of their own",
                    "items": {
                      "$ref": "#/$defs/MenuLeaf"
                    }
                  }
                },
                "required": [
                  "id",
                  "label"
                ]
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/ComponentId",
          "description": "the component's id, unique on its surface"
        },
        "catalogId": {
          "$ref": "#/$defs/CatalogId"
        },
        "accessibility": {
          "$ref": "#/$defs/AccessibilityAttributes"
        },
        "metadata": {
          "$ref": "#/$defs/ComponentMetadata"
        }
      },
      "required": [
        "component",
        "items"
      ],
      "additionalProperties": false
    },
    "Split": {
      "description": "Two or three panes side by side or one over another, with a separator a person drags or moves by keyboard (the WAI-ARIA Window Splitter pattern), panes that collapse to a rail, sizes kept per person in the browser, and panes that stack below a width.",
      "type": "object",
      "properties": {
        "component": {
          "const": "Split"
        },
        "orientation": {
          "enum": [
            "horizontal",
            "vertical"
          ],
          "default": "horizontal"
        },
        "persist": {
          "type": "string",
          "description": "the key a browser keeps this split's sizes under; empty keeps none"
        },
        "stackBelow": {
          "type": "integer",
          "description": "below this width in pixels the panes stack; 0 never",
          "default": 0
        },
        "panes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "child": {
                "$ref": "#/$defs/ComponentId",
                "description": "the id of the pane's one child"
              },
              "size": {
                "type": "number",
                "description": "the share of the split, 0 to 1"
              },
              "min": {
                "type": "integer",
                "description": "pixels the pane keeps before it collapses or stops",
                "default": 0
              },
              "collapsible": {
                "type": "boolean",
                "default": false
              },
              "label": {
                "type": "string",
                "description": "the pane's name, on its rail when collapsed and for a screen reader"
              }
            },
            "required": [
              "id",
              "size"
            ]
          },
          "minItems": 2,
          "maxItems": 3
        },
        "id": {
          "$ref": "#/$defs/ComponentId",
          "description": "the component's id, unique on its surface"
        },
        "catalogId": {
          "$ref": "#/$defs/CatalogId"
        },
        "accessibility": {
          "$ref": "#/$defs/AccessibilityAttributes"
        },
        "metadata": {
          "$ref": "#/$defs/ComponentMetadata"
        }
      },
      "required": [
        "component",
        "panes"
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "anyComponent": {
      "oneOf": [
        {
          "$ref": "#/components/Chart"
        },
        {
          "$ref": "#/components/Visualize"
        },
        {
          "$ref": "#/components/DataTable"
        },
        {
          "$ref": "#/components/Map"
        },
        {
          "$ref": "#/components/Graph"
        },
        {
          "$ref": "#/components/GraphView"
        },
        {
          "$ref": "#/components/Timeline"
        },
        {
          "$ref": "#/components/Report"
        },
        {
          "$ref": "#/components/Notification"
        },
        {
          "$ref": "#/components/Form"
        },
        {
          "$ref": "#/components/Stat"
        },
        {
          "$ref": "#/components/Window"
        },
        {
          "$ref": "#/components/Conversation"
        },
        {
          "$ref": "#/components/Notice"
        },
        {
          "$ref": "#/components/Toolbar"
        },
        {
          "$ref": "#/components/KeyValue"
        },
        {
          "$ref": "#/components/Prose"
        },
        {
          "$ref": "#/components/TitleBar"
        },
        {
          "$ref": "#/components/Menu"
        },
        {
          "$ref": "#/components/Split"
        }
      ],
      "discriminator": {
        "propertyName": "component"
      }
    },
    "anyFunction": {
      "description": "This catalog declares no functions of its own; a surface calls the basic catalog's functions, so no function call validates against this catalog alone.",
      "not": {}
    },
    "ComponentId": {
      "type": "string",
      "description": "The id of a component on the same surface (A2UI 1.0's ComponentId): a component's own id, or the id of the child, the menu or the map it names."
    },
    "CatalogId": {
      "type": "string",
      "description": "The catalog ID for this component, overriding any surface-level default catalogId (A2UI 1.0's ComponentCommon)."
    },
    "AccessibilityAttributes": {
      "$ref": "https://a2ui.org/specification/v1_0/common_types.json#/$defs/AccessibilityAttributes",
      "description": "A2UI 1.0's accessibility attributes: a label and a description for assistive technologies."
    },
    "ComponentMetadata": {
      "type": "object",
      "description": "Optional component-level metadata for vendor extensions (A2UI 1.0's ComponentCommon).",
      "properties": {
        "extensions": {
          "$ref": "https://a2ui.org/specification/v1_0/common_types.json#/$defs/Extensions"
        }
      },
      "additionalProperties": false
    },
    "DataBinding": {
      "type": "object",
      "description": "A2UI 1.0's data binding: a JSON pointer into the data model. v0.9.1's {\"path\": ...} is not one.",
      "properties": {
        "@path": {
          "type": "string",
          "description": "a JSON pointer into the data model"
        }
      },
      "required": [
        "@path"
      ],
      "additionalProperties": false
    },
    "TextOrBinding": {
      "description": "a literal, or a DataBinding into the data model",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/DataBinding"
        }
      ]
    },
    "NamedAction": {
      "type": "object",
      "description": "the action a button or an item dispatches: its name and a context of literals",
      "properties": {
        "name": {
          "type": "string"
        },
        "context": {
          "type": "object"
        }
      },
      "required": [
        "name"
      ]
    },
    "HeaderAction": {
      "type": "object",
      "description": "a button in a header: an id, its words, an icon name, and the action it dispatches",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/NamedAction"
        }
      },
      "required": [
        "id",
        "label",
        "action"
      ]
    },
    "MenuLeaf": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "shortcut": {
          "type": "string",
          "description": "the keys shown beside the item, such as Ctrl+Shift+O; the menu answers them while it is open"
        },
        "group": {
          "type": "string",
          "description": "items of one group sit together, a separator between groups"
        },
        "disabled": {
          "type": "boolean",
          "default": false
        },
        "checked": {
          "$ref": "#/$defs/TextOrBinding",
          "description": "true or false, or {\"@path\": ...} into the data model"
        },
        "action": {
          "$ref": "#/$defs/NamedAction"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "description": "a submenu item: an item with no items of its own"
    }
  }
}
