target/
dependency-reduced-pom.xml
release.properties
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
.flattened-pom.xml
.mvn/wrapper/maven-wrapper.jar

# Compiled classes outside target (IDE builds)
*.class
hs_err_pid*
replay_pid*

# IDEs and editors
.vscode/
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.factorypath
.apt_generated/
.sts4-cache/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Logs and scratch
*.log
/tmp/

# JavaScript tooling, should a renderer or a script ever join the repository
node_modules/

# Peer key material and provider keys never belong in a repository
peer.key
peer.keys/
keys/
*.pem
*.p12
*.jks

# Local environment
.env
.env.local
